# Cổng server (Render tự động cấp PORT khi deploy)
PORT=3000

# Google AI Studio API Key (lấy tại https://aistudio.google.com/apikey)
# Bắt buộc cấu hình bảo mật phía máy chủ trong tệp .env (không hiển thị trên giao diện người dùng)
GEMINI_API_KEY=

# Model Gemini sử dụng (mặc định gemini-3.5-flash-lite cho độ trễ siêu tốc < 1.5s, tương thích cấu hình gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash-lite

# Mã PIN đăng nhập Góc Tổ Tư vấn Tâm lý (mặc định 11092026)
ADMIN_PIN=11092026

# Đặt thành "false" khi triển khai chính thức để ẩn gợi ý PIN demo trên giao diện đăng nhập
SHOW_DEMO_PIN_HINT=true

# Đường dẫn file SQLite (trên Render có Disk bền vững có thể trỏ tới /var/data/safeschool.db)
DB_PATH=./data/safeschool.db
