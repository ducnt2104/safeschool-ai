{
  "name": "safeschool-ai",
  "version": "1.0.0",
  "description": "SafeSchool AI (Lá chắn Số Học đường) - Nền tảng AI phát hiện sớm bắt nạt trực tuyến, sơ cứu tâm lý và tư vấn học đường ẩn danh cho học sinh THPT",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:init": "node database.js",
    "build:css": "tailwindcss -i ./src/tailwind-input.css -o ./public/tailwind.css --minify",
    "test": "node tests/api.test.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "safeschool",
    "cyberbullying",
    "gemini",
    "school-counseling",
    "vietnam",
    "ai"
  ],
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^3.3.0",
    "better-sqlite3": "^13.1.1",
    "chart.js": "^4.4.8",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "lucide": "^0.511.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.19"
  }
}
